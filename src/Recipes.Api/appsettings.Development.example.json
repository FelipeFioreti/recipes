{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "<connection string do banco de desenvolvimento>"
  },
  "AppSettings": {
    "Issuer": "Recipes.Api",
    "Audience": "Recipes.Client",
    "Secret": "<segredo com pelo menos 32 caracteres>",
    "RefreshTokenExpirationDays": 365,
    "AccessTokenExpirationMinutes": 15
  },
  "AllowedHosts": "*"
}
